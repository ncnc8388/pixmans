{
  "functions": {
    "api/**/*.go": {
      "regions": ["hkg1"],
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/yqk/.*",
      "dest": "/api/yqk/yqk.go"
    },
    {
      "src": "/favicon.ico",
      "dest": "https://assets.vercel.com/image/upload/front/favicon/vercel/favicon.ico"
    },
    {
      "src": "/.*",
      "dest": "/api/index.go"
    }
  ]
}
